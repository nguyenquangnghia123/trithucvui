# ========================================================
# Tri Thuc Vui - Environment Variables Configuration
# ========================================================

# Google Gemini API Key for server-side AI Tutor, Voice Live API and Question Generator
GEMINI_API_KEY=

# Firebase Client Configuration (Synced with firebase-applet-config.json)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Server runtime port (Default: 3000)
PORT=3000
NODE_ENV=development
